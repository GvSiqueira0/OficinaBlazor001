@page "/perfil"
@rendermode InteractiveServer

<input @bind="nome" placeholder="Digite seu nome"/>
<input @bind="idade" placeholder="Digite sua idade" type="int"/>
<input @bind="curso" placeholder="Digite seu curso"/>
<input @bind="cidade" placeholder="Digite sua cidade"/>

<h1>Olá, @nome!</h1>
<p>Você tem @idade anos.</p>
<p>Eu estudo @curso na cidade de @cidade</p>
<p>Daqui a 10 anos você terá @(idade +10) anos</p>

@code {
    string nome = "";
    int idade = 0;
    string curso = "";
    string cidade = "";
}